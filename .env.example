# Execution mode: mock | local | cloud
AGENTOPS_MODE=mock

# Cloud LLMs (used in cloud mode) — different families for cross-family eval
GROQ_API_KEY=
LLM_GENERATION_MODEL=llama-3.3-70b-versatile
LLM_EVALUATION_MODEL=mixtral-8x7b-32768

# Local LLMs (used in local mode) — different families for cross-family eval
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_GENERATION_MODEL=qwen2.5:7b
LOCAL_EVALUATION_MODEL=llama3.1:8b

# Web search
TAVILY_API_KEY=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentops
LANGSMITH_TRACING=true
PHOENIX_ENDPOINT=
TRACING_ENABLED=true

# Budget
DEFAULT_TOKEN_BUDGET=50000
BUDGET_TOKEN_LIMIT=50000

# Research
RESEARCHER_TIMEOUT_SECS=30
MAX_RECOVERY_ATTEMPTS=2
QUALITY_GATE_MAX_REVISIONS=2

# Search cache
AGENTOPS_SEARCH_CACHE_DIR=.agentops-cache/search
AGENTOPS_SEARCH_CACHE_TTL_SECONDS=2592000

# Audit log
AUDIT_DB_PATH=./audit.sqlite
